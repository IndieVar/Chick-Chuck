<!-- Contact Information -->
<hr>
<h6 class="text-gray-500 text-xl my-6 font-bold uppercase">
  <%= t('contacts')%>
</h6>

<div class="grid grid-cols-1 gap-6 md:grid-cols-2 mb-6">
    <!-- Additional Phone input -->
    <div>
       <%= form.label :additional_phone, class: "text-lg" %>
       <div class="grid grid-cols-3 gap-1">
         <%= form.select :additional_phone_country, phone_country_options,
          { selected: form.object.additional_phone_country },
          class: "col-span-1 text-base  block w-full px-2 py-2 mt-1 font-normal text-gray-700 bg-white border border-gray-300 rounded focus:border-blue-600 focus:outline-none"
         %>
         <%= form.telephone_field :additional_phone,
          class: "col-span-2 text-base  block w-full px-4 py-2 mt-1 font-normal text-gray-700 bg-white bg-clip-padding border border-solid border-gray-300 rounded transition ease-in-out focus:text-gray-700 focus:bg-white focus:border-blue-600 focus:outline-none",
          placeholder: '050 123 4567', value: form.object.formatted_additional_phone,
          required: false
         %>
       </div>
    </div>

    <!-- WhatsApp input -->
    <div>
       <%= form.label :whatsapp, 'WhatsApp', class: "text-lg" %>
       <div class="grid grid-cols-3 space-x-1 rtl:space-x-reverse">
       <%= form.select :whatsapp_country, phone_country_options,
        { selected: form.object.whatsapp_country },
        class: "col-span-1 text-base  block w-full px-4 py-2 mt-1 font-normal text-gray-700 bg-white border border-gray-300 rounded focus:border-blue-600 focus:outline-none"
       %>
       <%= form.text_field :whatsapp, 
        class: "col-span-2 text-base  block w-full px-4 py-2 mt-1 font-normal text-gray-700 bg-white bg-clip-padding border border-solid border-gray-300 rounded transition ease-in-out m-0 focus:text-gray-700 focus:bg-white focus:border-blue-600 focus:outline-none",
        placeholder: '050 123 4567', value: form.object.formatted_whatsapp,
        required: false
       %>
       </div>
    </div>

    <!-- Telegram input -->
    <div>
       <div class="flex items-center space-x-2 rtl:space-x-reverse">
           <%= form.label :telegram, 'Telegram', class: "text-lg" %>
           <!-- Popover button-->
           <%= render 'shared/buttons/popover', text: t('telegram.telegram_popover'), icon: 'icons/icons8-info-50.png'%>
       </div>
       <%= form.text_field :telegram, 
        class: "text-base  block w-full px-4 py-2 mt-1 font-normal text-gray-700 bg-white bg-clip-padding border border-solid border-gray-300 rounded transition ease-in-out m-0 focus:text-gray-700 focus:bg-white focus:border-blue-600 focus:outline-none",
        placeholder: '@example', value: current_user&.telegram,
        required: false
       %>
    </div>

    <!-- Facebook input -->
    <div>
       <div class="flex items-center space-x-2 rtl:space-x-reverse">
           <%= form.label :facebook, 'Facebook', class: "text-lg" %>
           <!-- Popover button-->
           <%= render 'shared/buttons/popover', text: t('facebook.facebook_popover'), icon: 'icons/icons8-info-50.png'%>
       </div>
       <%= form.text_field :facebook, 
        class: "text-base  block w-full px-4 py-2 mt-1 font-normal text-gray-700 bg-white bg-clip-padding border border-solid border-gray-300 rounded transition ease-in-out m-0 focus:text-gray-700 focus:bg-white focus:border-blue-600 focus:outline-none",
        placeholder: 'https://web.facebook.com/example',
        required: false
       %>
    </div>
</div>