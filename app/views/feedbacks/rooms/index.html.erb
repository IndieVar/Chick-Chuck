<% currently_at t('user_menu.chats') %>
<% provide :page_title, t('user_menu.chats') %>
<% provide :nav_title, t('user_menu.chats') %>
<% provide :nav_path, rooms_path %>

<%= turbo_stream_from [current_user, :rooms]%>

<div class="chat-list">
    <!-- Search chat -->
    <%= form_with url: :rooms, method: :get, data: {turbo_frame: '_top'}, class: "chat-list__search" do |f|%>
        <%= heroicon 'magnifying-glass', class: "chat-list__search-icon" %>
        <%= f.text_field :chatname, class: "chat-list__input", placeholder: t('chat.search'), autocomplete: 'off' %>
    <% end %>
    <!-- Rooms list -->
    <%= turbo_frame_tag :rooms, class: "chat-list__items" do %>
        <%= render @rooms, current_user: current_user%>
    <% end %>
</div>
