<%= provide :navbar do %>
  <header class="site-header bg-white/95 backdrop-blur-md fixed top-0 z-50 w-full">
    <div class="relative" data-controller="dropdown">
      <div class="site-header__container w-full max-w-screen-2xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="site-header__row flex items-center">
          <div class="site-header__brand">
            <%= link_to root_path, class: 'flex items-center', data: { turbo_frame: '_top' } do %>
              <%= image_tag('logo/relomio-mark.svg',
                class: 'site-header__mobile-logo sm:hidden object-contain', alt: 'Relomio') %>
              <%= image_tag('logo/relomio-logo.svg',
                class: 'site-header__desktop-logo hidden sm:block object-contain', alt: 'Relomio') %>
            <% end %>
          </div>

          <button
            data-action="dropdown#toggle click@window->dropdown#hide"
            type="button"
            class="site-header__mobile-toggle lg:hidden"
            aria-controls="mobile-menu-panel"
            aria-label="<%= t('pages.open_menu') %>"
          >
            <%= heroicon 'bars-3', class: 'h-5 w-5' %>
          </button>

          <nav class="site-header__nav hidden lg:flex items-center">
            <%= render 'shared/navigations/content_links_list',
              link_class: 'site-header__nav-link',
              current_page: current_page %>
          </nav>

          <div class="site-header__actions">
            <%= render 'shared/locales' %>
            <%= render 'shared/navigations/user_menu' %>
          </div>
        </div>
      </div>

      <%= render 'shared/navigations/mobile_menu', current_page: current_page %>
    </div>
  </header>
<% end %>
