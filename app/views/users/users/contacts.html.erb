<% currently_at 'Contacts'%>
<% provide :page_title, 'Contacts'%>

<%= render TurboProfileComponent.new(title: t('contacts'), user: @user, modal_class: 'contacts-modal') do %>
    <div class="contacts-modal__content">
        <%= tag.div class: 'contacts-modal__notice' do %>
            <%= heroicon 'information-circle', class: 'contacts-modal__notice-icon' %>
            <%= tag.p t('contacts_desc_html') %>
        <% end if @user.instance_of?(Company) %>

        <div class="contacts-modal__list" role="group">
            <% if @user.additional_phone.present? %>
                <%= link_to "tel:#{@user.additional_phone}", itemprop: 'telephone', class: 'contacts-modal__item contacts-modal__item--phone' do %>
                    <span class="contacts-modal__icon">
                        <%= heroicon 'phone-arrow-down-left', class: 'w-5 h-5' %>
                    </span>
                    <span class="contacts-modal__details">
                        <span class="contacts-modal__label"><%= t('activerecord.attributes.user.additional_phone') %></span>
                        <strong dir="ltr"><%= @user.formatted_additional_phone %></strong>
                    </span>
                <% end %>
            <% end %>

            <% if @user.whatsapp.present? %>
                <%= link_to "https://wa.me/#{@user.whatsapp.delete_prefix('+')}", target: '_blank', rel: 'noopener noreferrer', class: 'contacts-modal__item contacts-modal__item--whatsapp' do %>
                    <span class="contacts-modal__icon">
                        <%= image_tag asset_path('icons/icons8-whatsapp-48.png'), alt: 'WhatsApp' %>
                    </span>
                    <span class="contacts-modal__details">
                        <span class="contacts-modal__label">WhatsApp</span>
                        <strong dir="ltr"><%= @user.formatted_whatsapp %></strong>
                    </span>
                <% end %>
            <% end %>

            <% if @user.telegram.present? %>
                <%= link_to "https://telegram.me/#{@user.telegram.split(/@/).last}", target: '_blank', rel: 'noopener noreferrer', class: 'contacts-modal__item contacts-modal__item--telegram' do %>
                    <span class="contacts-modal__icon">
                        <%= image_tag asset_path('icons/icons8-telegram-app-48.png'), alt: 'Telegram' %>
                    </span>
                    <span class="contacts-modal__details">
                        <span class="contacts-modal__label">Telegram</span>
                        <strong dir="ltr"><%= @user.telegram %></strong>
                    </span>
                <% end %>
            <% end %>

            <% if @user.facebook.present? %>
                <%= link_to @user.facebook, target: '_blank', rel: 'noopener noreferrer', class: 'contacts-modal__item contacts-modal__item--facebook' do %>
                    <span class="contacts-modal__icon">
                        <%= image_tag asset_path('icons/icons8-facebook-48.png'), alt: 'Facebook' %>
                    </span>
                    <span class="contacts-modal__details">
                        <span class="contacts-modal__label">Facebook</span>
                        <strong dir="ltr"><%= "@#{@user.user_name}" %></strong>
                    </span>
                <% end %>
            <% end %>
        </div>
    </div>
<% end %>