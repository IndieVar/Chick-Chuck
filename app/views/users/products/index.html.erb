<% currently_at t('product.my_products') %>
<% provide :page_title, t('product.my_products') %>
<% provide :nav_title, t('product.my_products') %>
<% provide :nav_path, users_products_path %>

<!-- Page header -->
<header class="pcalc-hero myprod-hero">
    <div>
        <span class="pcalc-hero__eyebrow"><%= t('product.total_products') %>: <%= @pagy.count %></span>
        <h1 class="pcalc-hero__title"><%= t('product.my_products') %></h1>
    </div>
    <%= link_to new_users_product_path, class: "myprod-hero__add", data: { turbo_frame: "_top" } do %>
        <%= heroicon 'plus', class: 'w-5 h-5' %>
        <span><%= t('product.add_btn') %></span>
    <% end %>
</header>

<!-- Products Cards -->
<%= turbo_frame_tag 'products', class: "myprod-grid" do %>
    <%= render partial: 'contents/products/product', collection: @products %>
<% end %>

<% if @products.empty? %>
    <div class="myprod-empty">
        <%= heroicon 'archive-box', class: 'w-10 h-10' %>
        <p><%= t('product.empty_list') %></p>
        <%= link_to t('product.add_btn'), new_users_product_path, class: "myprod-hero__add", data: { turbo_frame: "_top" } %>
    </div>
<% end %>

<!-- Pagy -->
<div class="myprod-pagination">
    <%== pagy_nav(@pagy) if @pagy.pages > 1 %>
</div>
