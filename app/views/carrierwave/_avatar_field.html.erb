<div class="upload-zone upload-zone--avatar" data-controller="upload-preview" data-upload-preview-single-value="true">
  <%= form.label :avatar, class: "upload-zone__label" do %>
    <% if imageable&.avatar.present? %>
      <%= image_tag(imageable&.avatar_thumb, alt: "avatar", class: "upload-zone__current #{imageable.instance_of?(Company) ? 'upload-zone__current--wide' : ''}") %>
    <% else %>
      <%= heroicon 'photo', class: 'upload-zone__icon' %>
    <% end %>
    <div class="upload-zone__action">
      <span class="upload-zone__text">
        <%= t(imageable&.avatar.present? ? 'global.update' : 'global.upload',
              model: (imageable&.instance_of?(Company) ? Company : User).human_attribute_name('avatar')) %>
      </span>
      <%= form.file_field :avatar, multiple: false, class: "sr-only", accept: "image/png, image/jpeg, image/jpg",
          "data-upload-preview-target": "input", "data-action": "upload-preview#add" %>
    </div>
    <p class="upload-zone__hint">PNG, JPG, GIF up to 10MB</p>
  <% end %>
  <div class="upload-thumbs upload-thumbs--single" data-upload-preview-target="grid" hidden></div>
  <%= tag.p class: 'upload-zone__remove' do %>
    <%= form.check_box :remove_avatar %>
    <%= form.label :remove_avatar %>
  <% end if imageable&.avatar.present? %>
</div>
