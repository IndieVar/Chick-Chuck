<!-- Form for new User -->
<%= form_for(resource, as: resource_name, url: registration_path(resource_name),
    html: { class: 'client-registration__form', data: { turbo: 'false' } }) do |form| %>
  <%= render "shared/error_messages", resource: resource %>
  <%= form.hidden_field :locale, value: I18n.locale %>

  <section class="client-registration__section">
    <div class="client-registration__section-heading">
      <span>01</span>
      <%= tag.h2 t('sign_up.credential') %>
    </div>
    <div class="client-registration__field-grid">
      <%= render 'users/form/credential_info_fields', form: form %>
    </div>
  </section>

  <section class="client-registration__section">
    <div class="client-registration__section-heading">
      <span>02</span>
      <%= tag.h2 t('sign_up.personal') %>
    </div>
    <div class="client-registration__field-grid">
      <%= render 'users/form/personal_info_fields', form: form %>
    </div>
  </section>

  <section class="client-registration__section">
    <div class="client-registration__section-heading">
      <span>03</span>
      <%= tag.h2 t('sign_up.profile') %>
    </div>
    <%= render 'carrierwave/avatar_field', form: form, imageable: nil %>
  </section>

  <section class="client-registration__section client-registration__contacts">
    <div class="client-registration__section-heading">
      <span>04</span>
      <%= tag.h2 t('contacts') %>
    </div>
    <%= render 'users/form/contacts_section_fields', form: form %>
  </section>

  <div class="client-registration__submit">
    <%= form.submit t('sign_up.btn') %>
  </div>
<% end %>