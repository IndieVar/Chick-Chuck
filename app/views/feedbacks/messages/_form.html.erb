<%= turbo_frame_tag 'message-form' do%>
    <!-- Edit component -->
    <%= render 'edit_component', message: message if action_name == 'edit'%>
    <!-- Form -->
    <%= form_with model: [room, message], remote: true, 
        data: { controller: :form, action: "turbo:submit-end->form#clear" } do |form| %>
        <div class="chat-form" data-controller="image">
            <span id="Img" class="chat-form__previews"></span>
          <div class="chat-form__row">
              <!-- Upload Images -->
              <%= form.label :file, class: "chat-form__attach" do %>
                  <%= heroicon 'photo', class: "w-6 h-6" %>
                  <span class="sr-only">Upload image</span>
                  <%= form.fields_for :images, Image.new do |image| %>
                      <%= form.file_field :file, multiple: true, class: "sr-only", name: "images[file][]",
                      accept: "image/png, image/jpeg, image/jpg", "data-image-target": "input",
                      "data-action": "image#comment_preview" %>
                  <% end %>
              <% end %>
              <!-- Room id -->
              <%= form.hidden_field :room_id, value: @room.id %>
              <!-- Message content -->
              <%= form.text_field :content, id: "chat", autofocus: true, autocomplete: 'off', class: "chat-form__input", placeholder: t('message.placeholder'), required: true%>
              <!-- Button submit -->
              <%= form.button type: 'submit', class: "chat-form__send", data: { disable_with: false }  do %>
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-5 h-5 rtl:rotate-180">
                    <path d="M3.478 2.405a.75.75 0 00-.926.94l2.432 7.905H13.5a.75.75 0 010 1.5H4.984l-2.432 7.905a.75.75 0 00.926.94 60.519 60.519 0 0018.445-8.986.75.75 0 000-1.218A60.517 60.517 0 003.478 2.405z" />
                  </svg>
              <% end %>
          </div>
      </div>
    <% end %>
<% end %>