<section class="home-hero">
    <div class="home-hero__inner">
        <div class="home-hero__copy">
            <div class="home-hero__eyebrow">
                <span class="home-hero__dot"></span>
                <%= t('home_page.redesign.eyebrow') %>
            </div>
            <%= tag.h1 t('home_page.redesign.hero_title'), class: 'home-hero__title' %>
            <%= tag.p t('home_page.redesign.hero_description'), class: 'home-hero__description' %>

            <div class="home-hero__actions">
                <%= link_to users_path, class: 'home-button home-button--primary' do %>
                    <%= t('company.find_carrier') %>
                    <%= heroicon I18n.locale == :he ? 'arrow-small-left' : 'arrow-small-right', class: 'w-5 h-5' %>
                <% end %>
                <%= link_to products_path, class: 'home-button home-button--light' do %>
                    <%= t('pages.market') %>
                <% end %>
            </div>

            <% if @average_rating.present? %>
                <div class="home-hero__rating">
                    <span class="home-hero__stars" aria-hidden="true">★★★★★</span>
                    <span>
                        <strong><%= number_with_precision(@average_rating, precision: 1) %></strong>
                        <%= t('home_page.redesign.rating_caption') %>
                    </span>
                </div>
            <% end %>
        </div>

        <div class="home-hero__art">
            <div class="home-hero__image-wrap">
                <%= image_tag asset_path("bg/bg-truck-1000#{'-rtl' if I18n.locale == :he}.webp"),
                    alt: t('home_page.redesign.truck_alt'), class: 'home-hero__truck' %>
            </div>
            <div class="home-hero__floating home-hero__floating--reviews">
                <span class="home-hero__floating-icon">★</span>
                <span>
                    <strong><%= t('home_page.redesign.reviews_title') %></strong>
                    <small><%= t('home_page.redesign.reviews_description') %></small>
                </span>
            </div>
            <div class="home-hero__floating home-hero__floating--choice">
                <span class="home-hero__floating-icon">✓</span>
                <span>
                    <strong><%= t('home_page.redesign.choice_title') %></strong>
                    <small><%= t('home_page.redesign.choice_description') %></small>
                </span>
            </div>
        </div>
    </div>
</section>