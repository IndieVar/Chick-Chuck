<% unless user_signed_in? %>
  <%= link_to new_company_registration_path, class: "site-header__join-link hidden xl:inline-flex #{current_page?(new_company_registration_path) ? 'is-current' : ''}" do %>
    <%= t('company.sign_up.link') %>
  <% end %>
<% end %>

<div class="site-header__account">
  <% if user_signed_in? %>
    <div class="site-header__notification-actions">
      <%= render 'feedbacks/messages/notifications/notifications_section' %>
      <%= render 'feedbacks/notifications/notifications_section' %>
    </div>
  <% end %>

  <div class="user-menu relative z-40" data-controller="dropdown">
    <button
      id="user-menu-button"
      type="button"
      aria-controls="user-menu-panel"
      aria-haspopup="true"
      aria-label="<%= user_signed_in? ? "#{t('user_menu.account_menu')}: #{current_user.user_name}" : t('user_menu.sign_in') %>"
      data-action="dropdown#toggle click@window->dropdown#hide"
      class="user-menu__trigger"
    >
      <% if user_signed_in? %>
        <%= image_tag(current_user.avatar_thumb, class: 'user-menu__avatar', alt: '') %>
        <span class="user-menu__trigger-label"><%= current_user.user_name %></span>
      <% else %>
        <%= heroicon 'user-circle', class: 'user-menu__guest-icon' %>
        <span class="user-menu__trigger-label"><%= t('user_menu.sign_in') %></span>
      <% end %>
      <%= heroicon 'chevron-down', class: 'user-menu__chevron' %>
    </button>

    <div
      id="user-menu-panel"
      data-dropdown-target="menu"
      aria-labelledby="user-menu-button"
      class="user-menu__panel hidden absolute rtl:origin-top-left rtl:left-0 ltr:origin-top-right ltr:right-0 z-50 mt-2"
      data-transition-enter-from="opacity-0 scale-95"
      data-transition-enter-to="opacity-100 scale-100"
      data-transition-leave-from="opacity-100 scale-100"
      data-transition-leave-to="opacity-0 scale-95"
    >
      <% if user_signed_in? %>
        <div class="user-menu__identity" data-action="dropdown#toggle" tabindex="-1">
          <%= image_tag(current_user.avatar_thumb, class: 'user-menu__identity-avatar', alt: '') %>
          <div class="user-menu__identity-copy">
            <%= tag.h4 current_user.user_name, class: 'user-menu__identity-name' %>
            <%= tag.p current_user.email, class: 'user-menu__identity-email' %>
          </div>
        </div>

        <div class="user-menu__links">
          <%= render 'clients/shared/client_menu', link_class: 'user-menu__link' if client_signed_in? %>
          <%= render 'companies/shared/company_menu', link_class: 'user-menu__link' if company_signed_in? %>
          <%= render 'admins/shared/admin_menu', link_class: 'user-menu__link' if admin_signed_in? %>
        </div>
      <% else %>
        <div class="user-menu__guest-links">
          <%= link_to t('user_menu.sign_in'), new_client_session_path,
            class: 'user-menu__link user-menu__guest-link user-menu__guest-link--primary',
            data: { action: 'dropdown#toggle', turbo_frame: 'modal' },
            tabindex: '-1',
            id: 'clientSignInLink' %>

          <%= link_to t('user_menu.sign_up'), new_client_registration_path,
            class: 'user-menu__link user-menu__guest-link',
            data: { action: 'dropdown#toggle' },
            tabindex: '-1',
            id: 'clientSignUpLink' %>

          <div class="user-menu__company-block">
            <p class="user-menu__company-title"><%= t('company.sign_up.title') %></p>

            <%= link_to new_company_session_path,
              class: 'user-menu__link user-menu__company-link',
              data: { action: 'dropdown#toggle', turbo_frame: 'modal' },
              tabindex: '-1',
              id: 'companySignInLink' do %>
              <%= image_tag(asset_path('icons/icons8-in-transit-50.png'), class: 'user-menu__company-icon', alt: '') %>
              <%= t('user_menu.sign_in_company') %>
            <% end %>

            <%= link_to new_company_registration_path,
              class: 'user-menu__link user-menu__company-link',
              data: { action: 'dropdown#toggle' },
              tabindex: '-1',
              id: 'companySignUpLink' do %>
              <%= image_tag(asset_path('icons/icons8-in-transit-50.png'), class: 'user-menu__company-icon', alt: '') %>
              <%= t('company.sign_up.link') %>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>
