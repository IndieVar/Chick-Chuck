<!-- Carriers product form -->
<%= turbo_frame_tag @product do %>
    <!-- Carousel -->
    <%= tag.div (render 'carrierwave/images/carousel', object: @product), 
        class: "col-span-full md:px-[14rem] w-full justify-center mb-4" if ['edit', 'update'].include?(action_name) %>

    <!-- Product form -->
    <%= form_with model: [:users, @product], class: "contents", html: { multipart: true }, data: { controller: "dependent-select" } do |f| %>
      <!-- Errors -->
      <%= render 'shared/error_messages', resource: @product %>
      <div class="grid grid-cols-1 gap-6 mt-4 md:grid-cols-2">
          <!-- Category type -->
          <div class="flex items-center text-gray-600 justify-center space-x-2 rtl:space-x-reverse">
              <%= f.label :category, class: "text-lg" %>
              <%= render 'shared/searchable_select',
                aria_label: Product.human_attribute_name('category'),
                select: f.collection_select(:category_id, sort_alphabetically(@categories), :id, :title, { prompt: true, selected: @product.category_id },
                  { class: "text-base block w-full px-4 py-2 mt-1 font-normal text-gray-700 bg-white bg-clip-padding border border-solid border-gray-300 rounded transition ease-in-out m-0 focus:text-gray-700 focus:bg-white focus:border-blue-600 focus:outline-none rtl:bg-left", required: false, data: { dependent_select_target: "category", action: "change->dependent-select#filterThings" } }) %>
          </div>
          <!-- Type -->
          <div class="flex items-center text-gray-600 justify-center space-x-2 rtl:space-x-reverse">
              <%= f.label :thing, class: "text-lg" %>
              <%= render 'shared/searchable_select',
                aria_label: Product.human_attribute_name('thing'),
                select: f.select(:thing_id,
                options_for_select(
                  sort_alphabetically(@categories.flat_map { |category| category.things.to_a }.map(&:decorate))
                    .map { |thing| [thing.public_send(I18n.locale), thing.id, { data: { category_id: thing.category_id } }] },
                  @product.thing_id
                ),
                { prompt: true },
                { class: "text-base block w-full px-4 py-2 mt-1 font-normal text-gray-700 bg-white bg-clip-padding border border-solid border-gray-300 rounded transition ease-in-out m-0 focus:text-gray-700 focus:bg-white focus:border-blue-600 focus:outline-none rtl:bg-left", data: { dependent_select_target: "thing" } }) %>
          </div>
          <!-- District -->
          <div class="flex items-center text-gray-600 justify-center space-x-2 rtl:space-x-reverse">
              <%= f.label Product.human_attribute_name('district'), class: "text-lg" %>
              <%= render 'shared/searchable_select',
                aria_label: Product.human_attribute_name('district'),
                select: f.select(:district_id, options_from_collection_for_select(@districts, 'id', 'title', @product.district_id), { include_blank: t('global.select') }, { class: "text-base block w-full px-4 py-2 mt-1 font-normal text-gray-700 bg-white bg-clip-padding border border-solid border-gray-300 rounded transition ease-in-out m-0 focus:text-gray-700 focus:bg-white focus:border-blue-600 focus:outline-none rtl:bg-left", required: false, data: { dependent_select_target: "district", action: "change->dependent-select#filterCities" } }) %>
          </div>
          <!-- Type -->
          <div class="flex items-center text-gray-600 justify-center space-x-2 rtl:space-x-reverse">
              <%= f.label :city, class: "text-lg" %>
              <%= render 'shared/searchable_select',
                aria_label: Product.human_attribute_name('city'),
                select: f.select(:city_id,
                options_for_select(sort_alphabetically(@districts.flat_map(&:cities)).map { |city| [city.public_send(I18n.locale), city.id, { data: { district_id: city.district_id } }] }, @product.city_id),
                { prompt: true },
                { class: "text-base block w-full px-4 py-2 mt-1 font-normal text-gray-700 bg-white bg-clip-padding border border-solid border-gray-300 rounded transition ease-in-out m-0 focus:text-gray-700 focus:bg-white focus:border-blue-600 focus:outline-none rtl:bg-left", data: { dependent_select_target: "city" } }) %>
          </div>
          <!-- Condition -->
          <div class="flex items-center text-gray-600 justify-center space-x-2 rtl:space-x-reverse">
              <%= f.label :condition, class: "text-lg" %>
              <%= render 'shared/searchable_select',
                aria_label: Product.human_attribute_name('condition'),
                select: f.select(:condition, options_for_select(Product.condition_select, @product.condition), { include_blank: t('global.select') }, { class: "text-base block w-full px-4 py-2 mt-1 font-normal text-gray-700 bg-white bg-clip-padding border border-solid border-gray-300 rounded transition ease-in-out m-0 focus:text-gray-700 focus:bg-white focus:border-blue-600 focus:outline-none rtl:bg-left", required: false }) %>
          </div>
          <!-- Delivery -->
          <div class="flex items-center text-gray-600 justify-center space-x-2 rtl:space-x-reverse">
              <%= f.label :delivery, class: "text-lg" %>
              <%= render 'shared/searchable_select',
                aria_label: Product.human_attribute_name('delivery'),
                select: f.select(:delivery, options_for_select(Product.delivery_select, @product.delivery), { include_blank: t('global.select') }, { class: "text-base block w-full px-4 py-2 mt-1 font-normal text-gray-700 bg-white bg-clip-padding border border-solid border-gray-300 rounded transition ease-in-out m-0 focus:text-gray-700 focus:bg-white focus:border-blue-600 focus:outline-none rtl:bg-left", required: false }) %>
          </div>
          <!-- Title -->
          <div class="flex items-center text-gray-600 justify-center space-x-2 rtl:space-x-reverse col-span-full">
              <%= f.label :title, class: "text-lg" %>
              <%= f.text_field :title, class: "w-full mr-1 text-gray-700 bg-white border border-gray-300 rounded-md  focus:border-blue-500 dark:focus:border-blue-500 focus:outline-none rtl:bg-left focus:ring", placeholder: Product.human_attribute_name('title'), required: false%>
          </div>
          <!-- Description -->
          <div class="flex items-center text-gray-600 justify-center space-x-2 rtl:space-x-reverse col-span-full">
              <%= f.label :description, class: "text-lg" %>
              <%= f.text_area :description, class: "w-full p-2 mr-1 text-gray-700 bg-white border border-gray-300 rounded-md  focus:border-blue-500 dark:focus:border-blue-500 focus:outline-none rtl:bg-left focus:ring", placeholder: Product.human_attribute_name('description'), required: false%>
          </div>
          <!-- Price -->
          <div class="flex items-center text-gray-600 justify-center space-x-2 rtl:space-x-reverse">
              <%= render 'shared/buttons/popover', text: t('product.delivery.price_popover'), icon: 'icons/icons8-info-50.png' %>
              <%= f.label :price, class: "text-lg" %>
              <%= f.number_field :price, class: "w-full text-gray-700 bg-white border border-gray-300 rounded-md  focus:border-blue-500 dark:focus:border-blue-500 focus:outline-none rtl:bg-left focus:ring", placeholder: Product.human_attribute_name('price'), required: false%> 
              <span>₪</span>
          </div>
      </div>
         <!-- Image field -->
         <%= render 'carrierwave/image_field', form: f, imageable: @product%>
      <!-- Button Save -->
      <div class="flex justify-start mt-6">
          <%= f.submit t('global.save_btn'), class: "cursor-pointer px-6 py-2 leading-5 text-white transition-colors duration-200 transform  rounded-md  focus:outline-none rtl:bg-left bg-gradient-to-r from-blue-500 via-blue-600 to-blue-700 hover:bg-gradient-to-br focus:ring-4"%>
      </div>
    <% end %>
<% end %>