<%= turbo_frame_tag "notifications_modal" do %>
    <%= tag.div data: {
        controller: "turbo-modal",
        action: "turbo:submit-end->turbo-modal#submitEnd keyup@window->turbo-modal#closeWithKeyboard click@window->turbo-modal#closeBackground",
        turbo_modal_target: "modal"},
        class: "notifications-popup absolute rtl:left-0 ltr:right-0 z-50" do
    %>
      <div class="notifications-popup__header">
        <h2 class="notifications-popup__title"><%= @title %></h2>
      </div>
      <ul class="notifications-popup__list">
        <%= content %>
      </ul>
    <% end %>
<% end %>
