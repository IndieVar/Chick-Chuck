<% currently_at t('pages.home') %>
<% provide :page_title, t('pages.home') %>


<div class="redesign-home">
    <%= render 'main/index/header' %>

    <section class="home-search" aria-label="<%= t('company.find_carrier') %>">
        <div class="home-search__card">
            <%= render 'shared/navigations/companies_filter', path: users_path, frame: '_top', company: nil %>
        </div>
    </section>

    <%= render 'main/index/top_features' %>
    <%= render 'main/index/companies' %>
    <%= render 'main/index/market' %>
    <%= render 'main/index/moving_preparation' %>
    <%= render 'main/index/latest_news' if @news.present? %>
    <%= render 'main/index/newsletter' %>
</div>