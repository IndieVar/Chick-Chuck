<nav class="moving-preparation-toc" aria-label="<%= t('moving_preparation.list') %>">
    <h2 class="moving-preparation-toc__title"><%= t('moving_preparation.list') %></h2>
    <ol class="moving-preparation-toc__list">
        <% 10.times do |i| %>
            <li>
                <%= link_to "#content_#{i + 1}",
                    class: 'moving-preparation-toc__link',
                    data: { controller: 'scroll-to', 'scroll-to-offset-value' => '105' } do %>
                    <span class="moving-preparation-toc__number"><%= format('%02d', i + 1) %></span>
                    <span><%= t("moving_preparation.content_#{i + 1}_t") %></span>
                <% end %>
            </li>
        <% end %>
    </ol>
</nav>
