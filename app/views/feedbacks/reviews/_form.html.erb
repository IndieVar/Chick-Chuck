<!-- Rating form -->
<%= turbo_frame_tag dom_id(@reviewable, 'review_form') do %>
    <%= form_with model: @review, class: "review-form" do |f| %>
      <!-- Errors -->
      <% if @review.errors.any? %>
        <div class="review-form__errors" role="alert">
          <% @review.errors.each do |error| %>
            <p><%= error.full_message %></p>
          <% end %>
        </div>
      <% end %>
      <%= f.hidden_field :company_id, value: @reviewable.id %>
      <%= f.hidden_field :price, value: 0 %>
      <!-- Rating -->
      <fieldset class="review-form__rating">
        <legend class="review-form__label"><%= t('review.form.rating_desc') %></legend>
        <span class="star-cb-group">
          <% 5.downto(1) do |i| %>
            <%= f.radio_button :rating, i, id: "review_rating-#{i}", checked: @review.rating == i %>
            <%= f.label "rating-#{i}", i %>
          <% end %>
          <input type="radio" id="rating-0" name="rating" value="0" class="star-cb-clear" /><label for="rating-0">0</label>
        </span>
      </fieldset>
      <!-- Title -->
      <%= f.text_field :title, placeholder: t('review.form.title_placeholder'),
          'aria-label': t('review.form.title_placeholder'), class: "review-form__field" %>
      <!-- Content -->
      <%= f.text_area :content, placeholder: t('review.form.comment_placeholder'),
          'aria-label': t('review.form.comment_placeholder'), rows: 5, class: "review-form__field review-form__field--textarea" %>
      <!-- Submit -->
      <%= f.submit t('global.send_btn'), class: "review-form__submit" %>
    <% end %>
<% end %>
