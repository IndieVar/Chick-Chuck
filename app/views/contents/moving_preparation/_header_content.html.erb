<header class="moving-preparation-hero">
    <div class="moving-preparation-hero__copy">
        <div class="moving-preparation-hero__breadcrumb">
            <%= link_to t('pages.home'), root_path %>
            <%= heroicon 'chevron-right', class: 'w-3 h-3 rtl:-scale-x-100' %>
            <span><%= t('pages.knowledge_base') %></span>
        </div>
        <%= tag.h1 t('moving_preparation.title'), class: 'moving-preparation-hero__title' %>
        <%= tag.p t('moving_preparation.header'), class: 'moving-preparation-hero__description' %>
    </div>
    <div class="moving-preparation-hero__image">
        <%= image_tag 'bg/moving_preparation.webp', alt: t('moving_preparation.title') %>
        <span class="moving-preparation-hero__image-mark"><%= heroicon 'cube', class: 'w-6 h-6' %></span>
    </div>
</header>
