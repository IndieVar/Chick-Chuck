<section class="home-stats" aria-label="<%= t('home_page.redesign.stats_label') %>">
    <div class="home-stats__item">
        <strong><%= number_with_delimiter(@companies_count) %></strong>
        <span><%= t('home_page.redesign.carriers_count') %></span>
    </div>
    <% if @average_rating.present? %>
        <div class="home-stats__item">
            <strong><%= number_with_precision(@average_rating, precision: 1) %> / 5</strong>
            <span><%= t('home_page.redesign.average_rating') %></span>
        </div>
    <% end %>
    <div class="home-stats__item">
        <strong><%= I18n.available_locales.size %></strong>
        <span><%= t('home_page.redesign.interface_languages') %></span>
    </div>
    <div class="home-stats__item">
        <strong><%= number_with_delimiter(@products_count) %></strong>
        <span><%= t('home_page.redesign.listings_count') %></span>
    </div>
</section>