<!-- Company calculator -->
<%= turbo_frame_tag dom_id(current_company, :calculator), class: 'pcalc' do %>
    <div class="pcalc-intro">
        <%= heroicon 'information-circle', variant: :solid, class: 'pcalc-intro__icon' %>
        <%= tag.p t('calculator.company_calculator_html'), class: 'pcalc-intro__text' %>
    </div>
    <!-- Form -->
    <%= render 'companies/calculators/form', model: Calculator.new if current_company.calculator.blank?%>
    <%= render 'companies/calculators/form', model: current_company.calculator if current_company.calculator.present? %>
<% end %>
