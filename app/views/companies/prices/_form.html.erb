<%= form_with model: model, url: url, class: 'pcalc-row__form' do |f|%>
    <div class="pcalc-field__control" id="<%= dom_id(thing, 'flash')%>">
        <%= f.number_field :amount, class: "pcalc-input", required: true%>
        <span class="pcalc-unit">₪</span>
        <%= image_tag(asset_path('icons/icons8-done-40.png'), class: 'pcalc-done', alt: '') if price(thing).present?%>
    </div>
    <%= f.submit t('global.save_btn'), class: 'pcalc-save pcalc-save--small'%>
<% end %>
