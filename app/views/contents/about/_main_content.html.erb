<section class="about-features" id="content" aria-label="<%= t('pages.about') %>">
    <div class="about-features__grid">
        <article class="about-feature-card">
            <span class="about-feature-card__icon"><%= heroicon 'star', variant: 'solid', class: 'w-6 h-6' %></span>
            <%= tag.h2 t('about.carriers.title'), class: 'about-feature-card__title' %>
            <%= tag.p t('about.carriers.desc_html'), class: 'about-feature-card__description' %>
            <%= link_to users_path, class: 'about-feature-card__link' do %>
                <%= t('company.find_carrier') %>
                <%= heroicon 'arrow-right', class: 'w-4 h-4 rtl:-scale-x-100' %>
            <% end %>
        </article>

        <article class="about-feature-card">
            <span class="about-feature-card__icon"><%= heroicon 'shopping-bag', class: 'w-6 h-6' %></span>
            <%= tag.h2 t('about.market.title'), class: 'about-feature-card__title' %>
            <%= tag.p t('about.market.desc_html'), class: 'about-feature-card__description' %>
            <%= link_to products_path, class: 'about-feature-card__link' do %>
                <%= t('pages.market') %>
                <%= heroicon 'arrow-right', class: 'w-4 h-4 rtl:-scale-x-100' %>
            <% end %>
        </article>

        <article class="about-feature-card">
            <span class="about-feature-card__icon"><%= heroicon 'newspaper', class: 'w-6 h-6' %></span>
            <%= tag.h2 t('about.moving_preparation.title'), class: 'about-feature-card__title' %>
            <%= tag.p t('about.moving_preparation.desc_html'), class: 'about-feature-card__description' %>
            <%= link_to moving_preparation_path, class: 'about-feature-card__link' do %>
                <%= t('moving_preparation.title') %>
                <%= heroicon 'arrow-right', class: 'w-4 h-4 rtl:-scale-x-100' %>
            <% end %>
        </article>

        <article class="about-feature-card">
            <span class="about-feature-card__icon"><%= heroicon 'calculator', class: 'w-6 h-6' %></span>
            <%= tag.h2 t('about.calculator.title'), class: 'about-feature-card__title' %>
            <%= tag.p t('about.calculator.desc_html'), class: 'about-feature-card__description' %>
            <%= link_to calculator_path, class: 'about-feature-card__link' do %>
                <%= t('home_page.calculate') %>
                <%= heroicon 'arrow-right', class: 'w-4 h-4 rtl:-scale-x-100' %>
            <% end %>
        </article>
    </div>
</section>