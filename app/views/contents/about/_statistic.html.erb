
<section class="about-statistics">
    <h2 class="about-statistics__title"><%= t('about.statistics.title') %></h2>
    <dl class="about-statistics__grid">
        <div class="about-statistics__item">
            <dt><%= t('statistic.clients') %></dt>
            <dd><%= number_with_delimiter(@clients) %></dd>
        </div>
        <div class="about-statistics__item">
            <dt><%= t('statistic.carriers') %></dt>
            <dd><%= number_with_delimiter(@companies) %></dd>
        </div>
        <div class="about-statistics__item">
            <dt><%= t('statistic.products') %></dt>
            <dd><%= number_with_delimiter(@products) %></dd>
        </div>
        <div class="about-statistics__item">
            <dt><%= t('statistic.reviews') %></dt>
            <dd><%= number_with_delimiter(@reviews) %></dd>
        </div>
    </dl>
</section>
