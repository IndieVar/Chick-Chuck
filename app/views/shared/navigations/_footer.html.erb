<%= provide :footer do %>
    <footer class="redesign-footer">
        <%= link_to '#top', class: 'redesign-footer__top', data: { controller: 'scroll-to', 'scroll-to-offset-value' => '150' } do %>
            <%= image_tag 'icons/icons8-up-2-50.png', class: 'w-8 h-8', alt: t('global.back_to_top') %>
        <% end unless controller_name == 'errors' %>

        <div class="redesign-footer__inner">
            <div class="redesign-footer__grid">
                <div class="redesign-footer__about">
                    <%= link_to root_path, class: 'redesign-footer__brand' do %>
                        <%= image_tag 'logo/relomio-logo.svg', alt: 'Relomio', class: 'h-10 w-auto' %>
                    <% end %>
                    <%= tag.p t('home_page.redesign.footer_description') %>
                </div>

                <div class="redesign-footer__column">
                    <%= tag.h2 t('moving'), class: 'redesign-footer__heading' %>
                    <%= link_to t('company.carriers').capitalize, users_path %>
                    <%= link_to t('pages.market'), products_path %>
                    <%= link_to t('pages.calculator'), calculator_path %>
                </div>

                <div class="redesign-footer__column">
                    <%= tag.h2 t('pages.knowledge_base'), class: 'redesign-footer__heading' %>
                    <%= link_to t('moving_preparation.title'), moving_preparation_path %>
                    <%= link_to t('pages.about'), about_path %>
                    <%= link_to t('review.reviews'), feedbacks_path %>
                </div>

                <div class="redesign-footer__column">
                    <%= tag.h2 t('pages.about'), class: 'redesign-footer__heading' %>
                    <%= link_to "mailto:info@chick-chuck.com" do %>
                        <%= heroicon 'envelope', class: 'w-4 h-4' %>
                        info@chick-chuck.com
                    <% end %>
                    <%= tag.span class: 'redesign-footer__location' do %>
                        <%= heroicon 'map-pin', class: 'w-4 h-4' %>
                        <%= t('israel') %>
                    <% end %>
                    <%= render 'contents/feedbacks/shared/leave_feedback_button' %>
                </div>
            </div>

            <div class="redesign-footer__bottom">
                <span>© <%= Time.current.year %> Relomio. <%= t('global.all_rights_reserved') %></span>
                <%= render 'shared/locales' %>
            </div>
        </div>
    </footer>
<% end %>
