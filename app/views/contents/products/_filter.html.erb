<!-- Market filter -->
<%= form_with url: path, method: :get, data: {turbo_frame: 'products', controller: 'dependent-select'} do |f| %>
    <div class="w-full z-10 mx-auto bg-white divide-y rounded-lg shadow-md hover:shadow-lg p-3 border border-gray-300 text-gray-500">
        <!-- Category -->
        <div class="w-full h-14 items-center flex">
            <%= heroicon 'list-bullet', class: 'w-6 h-6 rtl:ml-1.5 ltr:mr-1.5', alt: "category"%>
            <%= render 'shared/searchable_select',
                aria_label: Product.human_attribute_name('category'),
                select: f.collection_select(:category_id, sort_alphabetically(@categories), :id, :title,
                    { include_blank: Product.human_attribute_name('category'), selected: params[:category_id]},
                    { onchange: 'this.form.submit()', class: "h-full text-base md:rounded-l-xl block w-full p-2.5 hover:text-gray-900 focus:ring-0 focus:border-gray-100 focus:text-gray-900 border-0 rtl:bg-left", data: { dependent_select_target: "category", action: "change->dependent-select#filterThings" } }) %>
        </div>
        <!-- Type -->
        <div class="w-full h-14 items-center flex">
            <%= heroicon 'bars-3-center-left', class: 'w-6 h-6 rtl:ml-1.5 ltr:mr-1.5', alt: "type"%>
            <%= render 'shared/searchable_select',
                aria_label: Product.human_attribute_name('thing'),
                select: f.select(:thing_id,
                    options_for_select(sort_alphabetically(Thing.all.decorate).map { |thing| [thing.title, thing.id, { data: { category_id: thing.category_id } }] }, params[:thing_id]),
                    { include_blank: Product.human_attribute_name('thing') },
                    { class: "h-full text-base md:rounded-l-xl block w-full p-2.5 hover:text-gray-900 focus:ring-0 focus:border-gray-100 focus:text-gray-900 border-0 rtl:bg-left", data: { dependent_select_target: "thing", action: "change->dependent-select#selectThing" } }) %>
        </div>
        <!-- District -->
        <div class="w-full h-14 items-center flex">
            <%= heroicon 'map-pin', class: 'w-6 h-6 rtl:ml-1.5 ltr:mr-1.5', alt: "district"%>
            <%= render 'shared/searchable_select',
                aria_label: Product.human_attribute_name('district'),
                select: f.collection_select(:district_id, @districts, :id, :title,
                    { include_blank: Product.human_attribute_name('district'), selected: params[:district_id]},
                    { onchange: 'this.form.submit()', class: "h-full text-base md:rounded-l-xl block w-full p-2.5 hover:text-gray-900 focus:ring-0 focus:border-gray-100 focus:text-gray-900 border-0 rtl:bg-left", data: { dependent_select_target: "district", action: "change->dependent-select#filterCities" } }) %>
        </div>
        <!-- City -->
        <div class="w-full h-14 items-center flex">
            <%= heroicon 'building-office-2', class: 'w-6 h-6 rtl:ml-1.5 ltr:mr-1.5', alt: "city"%>
            <%= render 'shared/searchable_select',
                aria_label: Product.human_attribute_name('city'),
                select: f.select(:city_id,
                    options_for_select(sort_alphabetically(City.all.decorate).map { |city| [city.title, city.id, { data: { district_id: city.district_id } }] }, params[:city_id]),
                    { include_blank: Product.human_attribute_name('city') },
                    { class: "h-full text-base md:rounded-l-xl block w-full p-2.5 hover:text-gray-900 focus:ring-0 focus:border-gray-100 focus:text-gray-900 border-0 rtl:bg-left", data: { dependent_select_target: "city", action: "change->dependent-select#selectCity" } }) %>
        </div>
        <!-- Condition -->
        <div class="w-full h-14 items-center flex">
            <%= heroicon 'information-circle', class: 'w-6 h-6 rtl:ml-1.5 ltr:mr-1.5', alt: "condition"%>
            <%= render 'shared/searchable_select',
                aria_label: Product.human_attribute_name('condition'),
                select: f.select(:condition, options_for_select(Product.condition_select, params[:condition]),
                    { include_blank: Product.human_attribute_name('condition')},
                    { onchange: 'this.form.submit()', class: "h-full text-base md:rounded-l-xl block w-full p-2.5 hover:text-gray-900 focus:ring-0 focus:border-gray-100 focus:text-gray-900 border-0 rtl:bg-left" }) %>
        </div>
        <!-- Delivery -->
        <div class="w-full h-14 items-center flex">
            <%= image_tag('icons/icons8-in-transit-50.png', class: 'w-5 h-5 mr-1', alt: "delivery")%>
            <%= render 'shared/searchable_select',
                aria_label: Product.human_attribute_name('delivery'),
                select: f.select(:delivery, options_for_select(Product.delivery_select, params[:delivery]),
                    { include_blank: Product.human_attribute_name('delivery')},
                    { onchange: 'this.form.submit()', class: "h-full text-base md:rounded-l-xl block w-full p-2.5 hover:text-gray-900 focus:ring-0 focus:border-gray-100 focus:text-gray-900 border-0 rtl:bg-left" }) %>
        </div>
        <!-- Seller -->
        <div class="w-full h-14 items-center flex">
            <%= heroicon 'users', class: 'w-6 h-6 rtl:ml-1.5 ltr:mr-1.5', alt: "seller"%>
            <%= render 'shared/searchable_select',
                aria_label: t('product.seller.title'),
                select: f.select(:seller, options_for_select(Product.seller_select, params[:seller]),
                    { include_blank: t('product.seller.title')},
                    { onchange: 'this.form.submit()', class: "h-full text-base md:rounded-l-xl block w-full p-2.5 hover:text-gray-900 focus:ring-0 focus:border-gray-100 focus:text-gray-900 border-0 rtl:bg-left" }) %>
        </div>
        <!-- Price -->
        <div class="grid grid-cols-2 w-full">
            <%= label :price, Price.model_name.human, class: 'text-start text-gray-700 col-span-full py-3'%>
            <%= f.number_field :price_min, value: params[:price_min], 
                class: 'ltr:rounded-l-lg rtl:rounded-r-lg border-gray-300', placeholder: t('product.price.min')%>
            <%= f.number_field :price_max, value: params[:price_max], 
                class: 'ltr:rounded-r-lg rtl:rounded-l-lg  border-gray-300', placeholder: t('product.price.max')%>
        </div>

        <!-- Submit -->
        <%= tag.div class: "w-full h-auto p-3" do %>
            <%= f.submit t('global.find_btn', model: Product.model_name.human.downcase), class: "flex items-center justify-center w-full px-2 py-2 h-full text-base font-medium text-gray-300 bg-gray-800 rounded-lg border border-gray-800 hover:bg-gray-900 focus:ring-1 focus:outline-none focus:ring-gray-300"%>
        <% end %>
<% end %>
        <!-- Market link -->
        <%= tag.div class: "w-full h-auto p-3" do %>
            <%= link_to products_path, data: {turbo_frame: '_top'},
                class: "flex items-center justify-center w-full px-2 py-2 h-full text-base font-medium text-gray-300 bg-gray-800 rounded-lg border border-gray-800 hover:bg-gray-900 focus:ring-1 focus:outline-none focus:ring-gray-300" do %>
                <%= t('product.all_products')%>
                <%= heroicon I18n.locale == :he ? 'arrow-left' : 'arrow-right', class: "w-5 h-5 rtl:mr-2 ltr:ml-2", alt: "arrow-right"%>
            <% end %>
        <% end if action_name == 'user_products'%>
    </div>
