<%= turbo_frame_tag "modal" do %>
  <%= tag.div class: "review-modal__backdrop", aria: { hidden: true } %>
  <%= tag.div data: { 
      controller: "turbo-modal", 
      action: "turbo:submit-end->turbo-modal#submitEnd keyup@window->turbo-modal#closeWithKeyboard click@window->turbo-modal#closeBackground",
      turbo_modal_target: "modal"},
      class: "review-modal fixed top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2 z-50" do 
  %>
      <div class="review-modal__panel">
        <div class="review-modal__header">
            <span class="review-modal__mark" aria-hidden="true">
              <%= heroicon 'star', variant: 'solid', class: 'w-5 h-5' %>
            </span>
            <!-- Title -->
            <%= tag.h1 @title, class: "review-modal__title"%>
            <!-- Close button -->
            <%= render 'shared/buttons/close'%>
        </div>
        <!-- Content -->
        <div class="review-modal__content">
          <%= content %>
        </div>
      </div>
  <% end %>
<% end %>
