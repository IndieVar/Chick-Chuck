<!DOCTYPE html>
<html class="h-full bg-gray-50 scroll-smooth" <%= html_language_attributes %>>
  <head>
    <% google_tag_manager_enabled = session[:cookies_accepted].present? %>
    <!-- Meta -->
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= display_meta_tags(default_meta_tags) %>
    <%= render 'shared/meta/favicon'%>
    <%= render 'shared/meta/head_assets' %>
    <!-- Google tag manager -->
    <%= render 'shared/meta/google_tag_head' if google_tag_manager_enabled %>
    <!-- Trix editor -->
    <% if current_page?(new_company_registration_url) %>
        <%= javascript_import_module_tag "trix" %>
        <%= javascript_import_module_tag "@rails/actiontext" %>
    <% end %>
    <!-- Current user -->
    <%= render 'shared/meta/current_user_meta' if user_signed_in? %>
  </head>

  <body class="flex min-h-screen w-full min-w-0 flex-col justify-between">
      <!-- Google Tag Manager (noscript) -->
      <%= render 'shared/meta/google_tag_body' if google_tag_manager_enabled %>
      <!-- Schema json -->
      <%= render 'shared/meta/breadcrumbs_navbar_json'%>
      <%= yield :schema_json %>
      <!-- Current user id -->
      <%= turbo_stream_from "broadcast_to_user_#{current_user.id}" if user_signed_in?%>
      <!-- Header -->
      <%= yield :navbar%>
      <!-- Main -->
      <main class="relative  grid min-w-0 grid-cols-1 auto-rows-max grid-flow-row <%= 'mt-20' unless controller_name == 'errors' %>" id="top">
          <!-- Coockies -->
          <%= render 'shared/meta/cookies_banner' if session[:cookies_accepted].nil? %>
          <!-- Flash messages -->
          <% unless ['new', 'create'].include?(action_name) %>
              <%= tag.div (render 'shared/flash_messages'), id: "flash_messages", 
                  class: "fixed right-3 sm:right-6 sm:top-20 z-30 sm:max-w-sm'"%>
          <% end %>
          <!-- Modal -->
          <%= turbo_frame_tag 'modal'%>
          <!-- Content -->
          <div class="relative min-h-screen min-w-0 w-full">
              <%= yield %>
          </div>
      </main>      
      <!-- Footer -->
      <%= yield :footer %>
  </body>
</html>
