<!-- Company card -->
<% profile_page = controller_name == 'users' && action_name == 'show' %>
<%= turbo_frame_tag company, 
    class: "bg-white py-4 rounded-lg border-gray-200 shadow-md hover:shadow-xl #{'border' unless ['show', 'modal'].include?(action_name) } #{'company-profile__card' if profile_page}" do %>
    <div class="flex flex-col items-center space-y-4 <%= 'company-profile__card-content' if profile_page %>">
        <!-- Header -->
        <% if profile_page %>
            <div class="company-profile__layout">
                <%= render 'companies/shared/company_info', company: company %>
            </div>
        <% else %>
            <%= render 'companies/shared/company_info', company: company %>
        <% end %>
        <!-- Footer -->
        <%= tag.div class: "col-span-full flex flex-col space-y-4 pt-1 justify-center items-center text-gray-500 text-sm #{'company-profile__views' if profile_page}" do %>
            <!-- Views -->
            <%= render 'shared/buttons/views', object: company, popover_target: company.title %>
            <!-- Created at -->
            <%# tag.span company.decorate.created_at, class: 'text-sm text-gray-500'%>
        <% end %>
        <!-- Gallery -->
        <%= tag.div class: "w-full sm:w-1/2 flex-shrink-0 bg-white rounded-lg border border-gray-200 shadow-md hover:shadow-xl #{'company-profile__gallery' if profile_page}" do %>
            <% if profile_page %>
                <div class="company-profile__gallery-heading">
                    <h2><%= t('company.gallery.title') %></h2>
                    <span><%= t('company.gallery.images_count', count: company.images.size) %></span>
                </div>
            <% end %>
            <!-- Images -->
            <%= render 'carrierwave/images/carousel', object: company %>
        <% end if company.images.present? %>
    </div>
<% end %>

