<div class="cabinet-nav">
    <!-- User sidebar menu header -->
    <div class="cabinet-nav__user">
        <%= image_tag(current_user.avatar_thumb, class: "cabinet-nav__avatar", alt: "user-avatar") %>
        <div class="cabinet-nav__who">
            <%= tag.h4 current_user.user_name, class: "cabinet-nav__name" %>
            <%= tag.p current_user.email, class: "cabinet-nav__email" %>
        </div>
    </div>

    <!-- User sidebar menu links list -->
    <nav class="cabinet-nav__links">
        <%= render 'admins/shared/admin_menu', link_class: "cabinet-nav__link" if admin_signed_in? %>
        <%= render 'clients/shared/client_menu', link_class: "cabinet-nav__link" if client_signed_in? %>
        <%= render 'companies/shared/company_menu', link_class: "cabinet-nav__link" if company_signed_in? %>
    </nav>
</div>
