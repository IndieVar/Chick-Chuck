<!-- Form for new Company -->
<%= form_for(resource, as: resource_name, url: registration_path(resource_name),
    html: { class: 'company-registration__form', data: { turbo: 'false', controller: 'checkbox-select-all' } }) do |form| %>
  <%= render "shared/error_messages", resource: resource %>
  <%= form.hidden_field :locale, value: I18n.locale %>

  <section class="company-registration__section">
    <div class="company-registration__section-heading">
      <span>01</span>
      <%= tag.h2 t('company.sign_up.credential') %>
    </div>
    <div class="company-registration__field-grid">
      <%= render 'users/form/credential_info_fields', form: form %>
    </div>
  </section>

  <section class="company-registration__section">
    <div class="company-registration__section-heading">
      <span>02</span>
      <%= tag.h2 t('company.sign_up.personal') %>
    </div>
    <div class="company-registration__field-grid">
      <%= render 'users/form/personal_info_fields', form: form %>
    </div>
  </section>

  <section class="company-registration__section">
    <div class="company-registration__section-heading">
      <span>03</span>
      <%= tag.h2 t('company.about') %>
    </div>
    <div class="company-registration__field-grid company-registration__field-grid--company">
    <!-- Company name input -->
    <div>
       <div class="flex items-center">
           <span class="text-red-500 mr-1">&nbsp;*</span>
           <%= form.label :title, class: "text-lg" %>
       </div>
       <%= form.text_field :title, autocomplete: "phone", 
        class: "text-base  block w-full px-4 py-2 mt-1 font-normal text-gray-700 bg-white bg-clip-padding border border-solid border-gray-300 rounded transition ease-in-out m-0 focus:text-gray-700 focus:bg-white focus:border-blue-600 focus:outline-none",
        placeholder: Company.human_attribute_name('title'),
        required: true
       %>
    </div>

    <div>
       <%= form.label :website, 'Website URL', class: "text-lg" %>
       <%= form.text_field :website, autocomplete: "phone", 
        class: "text-base  block w-full px-4 py-2 mt-1 font-normal text-gray-700 bg-white bg-clip-padding border border-solid border-gray-300 rounded transition ease-in-out m-0 focus:text-gray-700 focus:bg-white focus:border-blue-600 focus:outline-none",
        placeholder: "https://example.com/",
        required: false
       %>
    </div>
    </div>

    <div class="company-registration__choice-group">
       <div class="flex items-center">
           <span class="text-red-500 mr-1">&nbsp;*</span>
           <%= form.label :districts, class: "text-lg" %>
       </div>
       <div class="company-registration__choices grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-3 mt-1">
          <%= form.collection_check_boxes(:district_ids, District.all, :id, I18n.locale) do |b| %> 
              <%= b.label class: "company-registration__choice text-base block w-full p-2 font-normal text-gray-700 bg-white bg-clip-padding border border-solid border-gray-300", data: {'checkbox-select-all-target' => b.text == District.first.decorate.title ?  "checkboxAll" : ''} do %>
                    <%= b.check_box data: { checkbox_select_all_target: 'checkbox' } %>
                    <%= b.text %>
              <% end %>
          <% end%>
       </div>
    </div>
    
    <!-- Languages -->
    <div class="company-registration__choice-group">
       <div class="flex items-center">
           <span class="text-red-500 mr-1">&nbsp;*</span>
           <%= form.label :languages, class: "text-lg mr-1" %>
           <%= render 'shared/buttons/popover', text: t('language.language_select')%>
       </div>
       <div class="company-registration__choices grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-3 mt-1">
          <%= form.collection_check_boxes(:language_ids, Language.all, :id, :title) do |b| %>
              <%= b.label(class: "company-registration__choice text-base block w-full p-2 font-normal text-gray-700 bg-white bg-clip-padding border border-solid border-gray-300") { b.check_box + '  ' + b.text}%>
          <% end%>
       </div>
    </div>
    
    <!-- Services -->
    <div class="company-registration__choice-group">
       <div class="flex items-center">
           <span class="text-red-500 mr-1">&nbsp;*</span>
           <%= form.label :services, class: "text-lg" %>
       </div>
       <div class="company-registration__choices grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-3 mt-1">
           <%= form.collection_check_boxes(:service_ids, Service.all, :id, I18n.locale) do |b| %>
               <%= b.label(class: "company-registration__choice text-base block w-full p-2 font-normal text-gray-700 bg-white bg-clip-padding border border-solid border-gray-300") { b.check_box + '  ' + b.text}%>
           <% end%>
       </div>
    </div>
  </section>

  <section class="company-registration__section">
    <div class="company-registration__section-heading">
      <span>04</span>
      <%= tag.h2 t('company.sign_up.profile') %>
    </div>
    <div class="company-registration__description">
       <div class="flex items-center space-x-2 rtl:space-x-reverse">
           <%= form.label :description, class: "text-lg" %>
           <%= render 'shared/buttons/popover', text: t('company.sign_up.slogan_length', length: 1000), icon: "icons/icons8-info-50.png"%>
       </div>
       <div class="text-gray-600 justify-center col-span-full mt-6 w-full">
           <%= form.rich_text_area :description, class: "w-full p-2 mr-1 text-gray-700 bg-white border border-gray-300 rounded-md  focus:border-blue-500 focus:outline-none focus:ring"%>
       </div>
    </div>
    <div class="company-registration__avatar-field">
      <%= render 'carrierwave/avatar_field', form: form, imageable: nil %>
    </div>
  </section>

  <section class="company-registration__section company-registration__contacts">
    <div class="company-registration__section-heading">
      <span>05</span>
      <%= tag.h2 t('contacts') %>
    </div>
    <%= render 'users/form/contacts_section_fields', form: form %>
  </section>

  <div class="company-registration__submit">
    <%= form.submit t('sign_up.btn') %>
  </div>
<% end %>