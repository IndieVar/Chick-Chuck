<section class="home-section home-carriers">
    <div class="home-section__heading">
        <div>
            <%= tag.h2 t('home_page.redesign.carriers_title'), class: 'home-section__title' %>
            <%= tag.p t('home_page.redesign.carriers_description'), class: 'home-section__description' %>
        </div>
        <%= link_to users_path, class: 'home-text-link', data: { turbo_frame: '_top' } do %>
            <%= t('company.latest_carriers') %>
            <%= heroicon I18n.locale == :he ? 'arrow-small-left' : 'arrow-small-right', class: 'w-5 h-5' %>
        <% end %>
    </div>

    <%= turbo_frame_tag 'companies', class: 'home-carrier-grid' do %>
        <% if @companies.present? %>
            <%= render partial: 'companies/shared/company_card', collection: @companies %>
        <% else %>
            <%= tag.div (render 'contents/shared/unavailable', model: t('company.carriers')), class: 'col-span-full' %>
        <% end %>
    <% end %>
</section>