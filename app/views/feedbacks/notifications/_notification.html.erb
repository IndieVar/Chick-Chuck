<% notification_url = notification&.to_notification&.url %>
<% if notification_url.present? %>
    <% parsed_url = URI.parse(notification_url) %>
    <% path_segments = parsed_url.path.split('/') %>
    <% available_locales = I18n.available_locales.map(&:to_s) %>
    <% if available_locales.include?(path_segments[1]) %>
        <% path_segments[1] = I18n.locale.to_s %>
    <% else %>
        <% path_segments.insert(1, I18n.locale.to_s) %>
    <% end %>
    <% parsed_url.path = path_segments.join('/') %>
    <% notification_url = parsed_url.to_s %>
<% end %>
<li>
    <%= link_to notification_url, data: {turbo_frame: '_top'}, class: "flex items-center font-medium block px-4 py-2 text-gray-800 hover:bg-gray-100 #{'bg-blue-50' if notification&.unread?}" do %>
        <%= image_tag (notification&.to_notification&.avatar), class: 'w-7 h-7 mr-3 rounded-full object-cover'%>
        <div>
            <p class="text-gray-800 mr-3 font-semibold">
              <%= notification&.to_notification&.author %>
            </p>
            <p class="text-gray-600 mr-3">
              <%= notification&.to_notification&.message %>
            </p>
            <span class="text-gray-400 text-xs -ml-1">
                <%= notification&.created_at %>
            </span>
        </div>
    <% end %>
</li>
<hr>
