<% currently_at 'Notifications' %>
<% provide :page_title, 'Notifications' %>

<%= render TurboNotificationsComponent.new(title: t('notifications.title')) do %>
    <% if @visible_notifications.any? %>
        <%= render @visible_notifications.map(&:decorate) %>
    <% else %>
        <%= tag.li t('notification.no_notice'), class: 'notifications-popup__empty'%>
    <% end%>
<% end %>



       