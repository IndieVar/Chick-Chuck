<%= turbo_frame_tag category, class: 'pcalc-card' do %>
    <!-- Category title -->
    <%= tag.h2 category.title, class: "pcalc-card__title" %>
    <!-- Things -->
    <div class="pcalc-table">
        <div class="pcalc-table__head">
            <%= tag.div t('price.title') %>
            <%= tag.div t('calculator.price') %>
        </div>
        <%= render partial: 'companies/prices/thing', collection: category.things.decorate%>
    </div>
<% end %>
