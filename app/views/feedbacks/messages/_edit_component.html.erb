<!-- Edit component to form message -->
<div class="chat-edit">
    <%= heroicon 'pencil-square', class: "chat-edit__icon" %>
    <div class="chat-edit__body">
        <%= tag.span t('global.edit_btn'), class: 'chat-edit__label' %>
        <%= tag.p message.content, class: 'chat-edit__text' %>
    </div>
</div>
