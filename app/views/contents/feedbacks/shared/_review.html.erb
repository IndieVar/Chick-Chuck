<%= turbo_frame_tag review, class: 'feedback-review' do %>
    <article>
        <header class="feedback-review__author">
            <%= image_tag review.user.avatar_thumb, class: 'feedback-review__avatar', alt: review.user.user_name %>
            <div class="feedback-review__author-details">
                <%= tag.span review.user.user_name, class: 'feedback-review__author-name' %>
                <%= tag.time review.user.decorate.created_at,
                    datetime: review.user.decorate.created_at,
                    class: 'feedback-review__author-date' %>
            </div>
        </header>

        <%= tag.h3 review.title, class: 'feedback-review__title' %>
        <div class="feedback-review__rating">
            <div class="feedback-review__stars" aria-hidden="true">
                <% 1.upto(5) do |i| %>
                    <%= heroicon 'star', variant: 'solid',
                        class: "w-5 h-5 #{review_star_color(total_feedback_rating(review), i)}" %>
                <% end %>
            </div>
            <%= tag.p "#{t('feedback.total_rating')} #{t('review.out_of', count: total_feedback_rating(review))}",
                class: 'feedback-review__rating-label' %>
        </div>

        <footer class="feedback-review__date">
            <time datetime="<%= review.created_at %>"><%= review.decorate.created_at %></time>
        </footer>
        <%= tag.p review.content, itemprop: 'description', class: 'feedback-review__content' %>
    </article>
<% end %>
