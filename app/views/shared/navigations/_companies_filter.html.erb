<!-- Trucks filter -->
<%= form_with url: path, method: :get, data: {turbo_frame: frame, controller: 'checkbox-select-all'} do |f| %>
    <% home_page = controller_name == 'main' %>
    <% directory_page = controller_name == 'users' && action_name == 'index' %>
    <% filter_class = if home_page
        'home-filter grid grid-cols-1 sm:grid-cols-4'
    elsif directory_page
        'carrier-directory-filter grid grid-cols-1 sm:grid-cols-4'
    else
        "w-full absolute #{[action_name, controller_name].eql?(['index', 'main']) ? 'bottom-0' : 'top-0'} items-center z-10 grid grid-cols-1 sm:grid-cols-4 border-gray-700 bg-gray-700 border bg-opacity-90 rounded-tl-3xl rounded-br-3xl sm:mx-auto"
    end %>
    <% filter_field_class = if home_page
        'home-filter__field'
    elsif directory_page
        'carrier-directory-filter__field hidden sm:flex'
    else
        'hidden sm:flex'
    end %>
    <%= tag.div class: filter_class, data: { controller: 'reveal' } do %>
        <!-- District -->
        <div class="w-full h-14 items-center flex bg-opacity-90 font-medium rtl:pr-3 ltr:pl-3 rounded-tl-3xl rtl:sm:rounded-none <%= filter_field_class %>"
             data-reveal-target="item"
        >
            <%= tag.label District.model_name.human, for: 'district_id', class: home_page ? 'home-filter__label' : 'carrier-directory-filter__label' if home_page || directory_page %>
            <%= heroicon 'map', class: 'w-6 h-6 mr-1 text-gray-400' unless home_page || directory_page %>
            <%= f.collection_select(:district_id, District.all.decorate, :id, :title, 
            { include_blank: District.model_name.human, selected: params[:district_id]}, 
            {class: home_page ? "h-full text-base md:rounded-l-xl block w-full p-2.5 placeholder-gray-400 text-gray-300 hover:text-gray-100 focus:ring-0 focus:border-gray-100 focus:text-gray-100 border-0 rounded-tl-3xl rtl:bg-left rtl:ml-3 sm:ml-0 bg-opacity-90 bg-gray-700/0" : directory_page ? 'carrier-directory-filter__select' : "h-full text-base md:rounded-l-xl block w-full p-2.5 placeholder-gray-400 text-gray-300 hover:text-gray-100 focus:ring-0 focus:border-gray-100 focus:text-gray-100 border-0 rounded-tl-3xl rtl:bg-left rtl:ml-3 sm:ml-0 bg-opacity-90 bg-gray-600"})%>
        </div>
        <!-- Language -->
        <div class="w-full h-14 items-center flex relative bg-opacity-90 font-medium rtl:pr-3 rtl:rounded-tl-3xl ltr:pl-3 <%= filter_field_class %>"
            data-reveal-target="item"
        >
            <%= tag.label Language.model_name.human, for: 'language_id', class: home_page ? 'home-filter__label' : 'carrier-directory-filter__label' if home_page || directory_page %>
            <%= heroicon 'language', class: 'w-6 h-6 mr-1 text-gray-400' unless home_page || directory_page %>
            <%= f.collection_select(:language_id, Language.all, :id, :title, {include_blank: Language.model_name.human, selected: params[:language_id]}, {class: home_page ? "h-full text-base block w-full p-2.5 placeholder-gray-400 text-gray-300 hover:text-gray-100 focus:ring-0 focus:border-gray-100 focus:text-gray-100 border-0 rtl:rounded-tl-3xl rtl:bg-left rtl:ml-3 bg-opacity-90 bg-gray-700/0" : directory_page ? 'carrier-directory-filter__select' : "h-full text-base block w-full p-2.5 placeholder-gray-400 text-gray-300 hover:text-gray-100 focus:ring-0 focus:border-gray-100 focus:text-gray-100 border-0 rtl:rounded-tl-3xl rtl:bg-left rtl:ml-3 bg-opacity-90 bg-gray-600"})%>
        </div>
        <!-- Services -->
        <div class="w-full h-14 items-center flex justify-center border-0 relative bg-opacity-90 <%= filter_field_class %>"
            data-reveal-target="item" data-controller="services-filter"
        >
            <% if home_page || directory_page %>
                <%= tag.span Company.human_attribute_name('services'), class: home_page ? 'home-filter__label' : 'carrier-directory-filter__label' %>
            <% end %>
            <!-- Button -->
            <button id="dropdownServicesButton" data-dropdown-toggle="dropdownServices" class="inline-flex items-center w-full text-base font-medium text-center <%= home_page ? 'home-filter__services-button' : directory_page ? 'carrier-directory-filter__services-button' : 'text-gray-300 hover:text-gray-100' %>" type="button">
                <%= heroicon 'list-bullet', class: "w-6 h-6 mx-3 #{directory_page ? 'carrier-directory-filter__icon' : 'text-gray-400'}" unless home_page %>
                <%= home_page ? t('home_page.redesign.any_service') : Company.human_attribute_name('services') %>
                <span class="svc-count" data-services-filter-target="count" hidden></span>
                <%= heroicon 'chevron-down', class: "w-4 h-4 ml-auto #{directory_page ? 'carrier-directory-filter__icon' : 'text-gray-400'}" if home_page || directory_page %>
            </button>
            <!-- Services dropdown menu -->
            <div id="dropdownServices" class="svc-menu z-10 hidden min-w-full <%= home_page ? 'home-filter__services-menu' : 'carrier-directory-filter__services-menu' if home_page || directory_page %>">
                <div class="svc-search">
                    <%= heroicon 'magnifying-glass', class: 'w-4 h-4' %>
                    <input type="search" autocomplete="off" placeholder="<%= t('product.search_placeholder') %>"
                        data-services-filter-target="search" data-action="input->services-filter#filter keydown->services-filter#preventSubmit">
                </div>
                <ul class="svc-list text-start" aria-labelledby="dropdownServicesButton">
                    <!-- Select All / Deselect All -->
                    <li class="svc-item svc-item--all" data-services-filter-target="all">
                        <label class="svc-label">
                            <input type="checkbox" class="svc-check" data-checkbox-select-all-target="checkboxAll" data-action="change->services-filter#update" />
                            <span><%= "#{t('global.select_all')} / #{t('global.deselect_all')}" %></span>
                        </label>
                    </li>
                    <!-- Services list -->
                    <%= f.collection_check_boxes(:service_ids, Service.all.decorate.sort_by { |service| service.title.to_s.downcase }, :id, :title, multiple: true, checked: params[:service_ids]) do |b| %>
                        <li class="svc-item" data-services-filter-target="item">
                            <%= b.label(class: "svc-label") do %>
                                <%= b.check_box class: 'svc-check', data: { checkbox_select_all_target: 'checkbox', action: 'change->services-filter#update' } %>
                                <span><%= b.text %></span>
                            <% end %>
                        </li>
                    <% end %>
                    <li class="svc-empty" data-services-filter-target="empty" hidden><%= t('product.no_results') %></li>
                </ul>
            </div>
        </div>
        <!-- Search button -->
        <div class="w-full h-auto p-3 flex justify-center items-center space-x-2 rtl:space-x-reverse <%= home_page ? 'home-filter__submit' : 'carrier-directory-filter__controls' if home_page || directory_page %>">
            <button data-action="click->reveal#toggle" type="button" class="btn sm:hidden <%= 'hidden' if home_page %>" <%= "title=\"#{t('company.directory.filter_title')}\" aria-label=\"#{t('company.directory.filter_title')}\"" if directory_page %>>
                <%= heroicon 'adjustments-horizontal', class: "w-7 h-7 #{directory_page ? 'carrier-directory-filter__icon' : 'text-gray-300'}"%>
            </button>
            
            <%= button_tag t('company.find_carrier'), class: "flex items-center justify-center w-full px-2 py-2 h-full text-base font-medium rounded-lg border bg-opacity-90 focus:ring-1 focus:outline-none focus:ring-gray-300 #{home_page ? 'home-filter__button' : directory_page ? 'carrier-directory-filter__button' : 'bg-blue-600 border-blue-600 hover:bg-blue-700 text-gray-100'}", name: 'find carrier' %>
        </div>
    <% end %>
<% end %>