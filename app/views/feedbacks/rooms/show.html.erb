<% currently_at t('user_menu.chats') %>
<% provide :page_title, t('user_menu.chats') %>
<% provide :parent_title, t('user_menu.chats') %>
<% provide :parent_path, rooms_path %>
<% provide :nav_path, room_path(title: @room.title) %>
<% provide :nav_title, @room.recipient(@current_user).user_name %>

<%= turbo_stream_from @room%>

<% recipient = @room.recipient(@current_user) %>
<div class="chat">
    <!-- Room header -->
    <header class="chat__header">
        <%= link_to rooms_path, data: {turbo_frame: '_top'}, class: 'chat__back', aria: { label: t('user_menu.chats') } do %>
            <%= heroicon I18n.locale == :he ? "arrow-right" : "arrow-left", class: "w-5 h-5" %>
        <% end %>
        <% peer = capture do %>
            <%= image_tag recipient.avatar_thumb, class: "chat__avatar", alt: "" %>
            <%= tag.span recipient.user_name, class: "chat__name" %>
        <% end %>
        <% if recipient.instance_of?(Company) %>
            <%= link_to peer, user_path(recipient), data: {turbo_frame: '_top'}, class: "chat__peer" %>
        <% else %>
            <%= tag.div peer, class: "chat__peer" %>
        <% end %>
    </header>
    <!-- Messages -->
    <div class="chat__messages" data-controller="scroll" data-scroll-target="messages">
        <%= turbo_frame_tag "room_#{@room.id}_messages" do %>
            <%= render @messages %>
        <% end %>
    </div>
    <!-- Form -->
    <div class="chat__form">
        <%= render 'feedbacks/messages/form', room: @room, message: @new_message%>
    </div>
</div>
