<% notification_content = notification&.to_notification %>
<li class="notifications-popup__item">
    <%= link_to localized_notification_url(notification_content&.url), data: {turbo_frame: '_top'}, class: "notifications-popup__link #{'is-unread' if notification&.unread?}" do %>
        <%= image_tag notification_content&.avatar, class: 'notifications-popup__avatar' %>
        <div class="notifications-popup__body">
            <p class="notifications-popup__author"><%= notification_content&.author %></p>
            <p class="notifications-popup__message"><%= notification_content&.message %></p>
            <span class="notifications-popup__time"><%= notification&.created_at %></span>
        </div>
    <% end %>
</li>
