<%= turbo_frame_tag thing, class: "mx-auto grid w-full min-w-0 grid-cols-1 items-center gap-2 border-b border-b-gray-300 py-2 text-gray-600 hover:border-b-gray-500 hover:text-gray-800 sm:grid-cols-3 sm:gap-6" do %>
    <!-- Title -->
    <%= tag.div thing.title, class: "min-w-0 break-words sm:col-span-1"%>
    <!-- Price -->
    <%= render 'form', thing: thing, model: [thing, Price.new], url: companies_prices_path(thing_id: thing) if price(thing).blank?%>
    <%= render 'form', thing: thing, model: price(thing), url: companies_price_path(price(thing), thing_id: price(thing).thing_id) if price(thing).present? %>
<% end %>
