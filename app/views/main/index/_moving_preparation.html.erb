<section class="home-guide">
    <div class="home-section__heading">
        <div>
            <%= tag.h2 t('moving_preparation.title'), class: 'home-section__title' %>
            <%= tag.p t('home_page.redesign.guide_description'), class: 'home-section__description' %>
        </div>
        <%= link_to moving_preparation_path, class: 'home-text-link' do %>
            <%= t('global.view_all') %>
            <%= heroicon I18n.locale == :he ? 'arrow-small-left' : 'arrow-small-right', class: 'w-5 h-5' %>
        <% end %>
    </div>

    <div class="home-guide__grid">
        <% (1..3).each do |step| %>
            <article class="home-guide__card">
                <span class="home-guide__number"><%= format('%02d', step) %></span>
                <%= tag.h3 t("home_page.redesign.guide_step_#{step}_title"), class: 'home-guide__title' %>
                <%= tag.p t("home_page.redesign.guide_step_#{step}_description"), class: 'home-guide__text' %>
            </article>
        <% end %>
    </div>
</section>