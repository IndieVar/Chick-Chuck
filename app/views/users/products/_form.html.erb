<!-- Product form -->
<%= turbo_frame_tag @product, class: 'pform-frame' do %>
    <!-- Carousel -->
    <%= tag.div (render 'carrierwave/images/carousel', object: @product), class: "pform-carousel" if ['edit', 'update'].include?(action_name) %>

    <%= form_with model: [:users, @product], class: "pform", html: { multipart: true }, data: { controller: "dependent-select" } do |f| %>
      <!-- Errors -->
      <%= render 'shared/error_messages', resource: @product %>

      <!-- Product -->
      <section class="pform-card">
          <h2 class="pcalc-card__title"><%= t('product.about_title') %></h2>
          <div class="pform-grid">
              <!-- Category -->
              <div class="pform-field">
                  <%= f.label :category, class: "pform-label" %>
                  <%= f.collection_select(:category_id, @categories, :id, :title, { prompt: true, selected: @product.category_id },
                    { class: "pform-input", required: false, data: { dependent_select_target: "category", action: "change->dependent-select#filterThings" } }) %>
              </div>
              <!-- Thing -->
              <div class="pform-field">
                  <%= f.label :thing, class: "pform-label" %>
                  <div data-controller="searchable-select" data-searchable-select-always-value="true">
                  <%= f.select(:thing_id,
                    options_for_select(@categories.flat_map { |category| category.things.map { |thing| [thing.public_send(I18n.locale), thing.id, { data: { category_id: category.id } }] } }.sort_by { |option| option.first.to_s.downcase }, @product.thing_id),
                    { prompt: true },
                    { class: "pform-input", data: { dependent_select_target: "thing", action: "change->dependent-select#syncCategory" } }) %>
                  </div>
              </div>
              <!-- Condition -->
              <div class="pform-field">
                  <%= f.label :condition, class: "pform-label" %>
                  <%= f.select(:condition, options_for_select(Product.condition_select, @product.condition), {include_blank: t('global.select')}, {class: "pform-input", required: false})%>
              </div>
              <!-- Price -->
              <div class="pform-field">
                  <div class="pform-label pform-label--row">
                      <%= f.label :price, class: "pform-label" %>
                      <%= render 'shared/buttons/popover', text: t('product.delivery.price_popover'), icon: 'icons/icons8-info-50.png' %>
                  </div>
                  <div class="pcalc-field__control">
                      <%= f.number_field :price, class: "pform-input", placeholder: Product.human_attribute_name('price'), required: false %>
                      <span class="pcalc-unit">₪</span>
                  </div>
              </div>
              <!-- Title -->
              <div class="pform-field pform-field--full">
                  <%= f.label :title, class: "pform-label" %>
                  <%= f.text_field :title, class: "pform-input", placeholder: Product.human_attribute_name('title'), required: false %>
              </div>
              <!-- Description -->
              <div class="pform-field pform-field--full">
                  <%= f.label :description, class: "pform-label" %>
                  <%= f.text_area :description, rows: 4, class: "pform-input pform-input--area", placeholder: Product.human_attribute_name('description'), required: false %>
              </div>
          </div>
      </section>

      <!-- Location and delivery -->
      <section class="pform-card">
          <h2 class="pcalc-card__title"><%= t('product.location_title') %></h2>
          <div class="pform-grid">
              <!-- District -->
              <div class="pform-field">
                  <%= f.label Product.human_attribute_name('district'), class: "pform-label" %>
                  <%= f.select(:district_id, options_from_collection_for_select(@districts, 'id', 'title', @product.district_id), { include_blank: t('global.select') }, { class: "pform-input", required: false, data: { dependent_select_target: "district", action: "change->dependent-select#filterCities" } }) %>
              </div>
              <!-- City -->
              <div class="pform-field">
                  <%= f.label :city, class: "pform-label" %>
                  <div data-controller="searchable-select" data-searchable-select-always-value="true">
                  <%= f.select(:city_id,
                    options_for_select(@districts.flat_map { |district| district.cities.map { |city| [city.public_send(I18n.locale), city.id, { data: { district_id: district.id } }] } }.sort_by { |option| option.first.to_s.downcase }, @product.city_id),
                    { prompt: true },
                    { class: "pform-input", data: { dependent_select_target: "city", action: "change->dependent-select#syncDistrict" } }) %>
                  </div>
              </div>
              <!-- Delivery -->
              <div class="pform-field pform-field--full">
                  <%= f.label :delivery, class: "pform-label" %>
                  <%= f.select(:delivery, options_for_select(Product.delivery_select, @product.delivery), {include_blank: t('global.select')}, {class: "pform-input", required: false})%>
              </div>
          </div>
      </section>

      <!-- Images -->
      <section class="pform-card">
          <h2 class="pcalc-card__title"><%= t('global.images') %></h2>
          <%= render 'carrierwave/image_field', form: f, imageable: @product %>
      </section>

      <!-- Actions -->
      <div class="pform-actions">
          <%= link_to t('product.my_products'), users_products_path, class: "pform-back" %>
          <%= f.submit t('global.save_btn'), class: 'pcalc-save' %>
      </div>
    <% end %>
<% end %>
