<% currently_at t('review.reviews') %>
<% provide :page_title, t('review.reviews') %>

<main class="feedbacks-page">
    <header class="feedbacks-hero">
        <span class="feedbacks-hero__eyebrow"><%= t('pages.knowledge_base') %></span>
        <%= tag.h1 t('comment.about_page_title'), class: 'feedbacks-hero__title', id: 'feedback_title' %>
        <%= render 'contents/feedbacks/shared/rating' %>
    </header>

    <section class="feedbacks-page__summary" aria-label="<%= t('feedback.total_rating') %>">
        <%= render 'contents/feedbacks/shared/global_feedbacks' %>
    </section>

    <% if (client_signed_in? || company_signed_in?) && !@feedback.id.present? %>
        <section class="feedbacks-page__form-panel">
            <div class="feedbacks-page__form-heading">
                <%= heroicon 'chat-bubble-bottom-center-text', class: 'w-5 h-5' %>
                <%= tag.h2 t('feedback.form.title') %>
            </div>
            <%= render 'contents/feedbacks/form' %>
        </section>
    <% else %>
        <div class="feedbacks-page__action">
            <%= render 'contents/feedbacks/shared/edit_feedback_button' %>
        </div>
    <% end %>

    <section class="feedbacks-page__reviews" id="reviews">
        <div class="feedbacks-page__reviews-heading">
            <%= tag.h2 t('review.reviews') %>
            <span><%= @reviews.count %></span>
        </div>
        <div class="feedbacks-page__reviews-grid" id="reviews_list">
            <% if @reviews.any? %>
                <%= render partial: 'contents/feedbacks/shared/review', collection: @reviews %>
            <% else %>
                <p class="feedbacks-page__empty"><%= t('review.no_feedback') %></p>
            <% end %>
        </div>
    </section>
</main>
