<section class="about-hero">
    <div class="about-hero__inner">
        <div class="about-hero__copy">
            <span class="about-hero__eyebrow"><%= t('pages.about') %></span>
            <%= tag.h1 t('about.header.title'), class: 'about-hero__title' %>
            <%= tag.p t('about.header.desc'), class: 'about-hero__description' %>
            <div class="about-hero__founder">
                <span class="about-hero__founder-mark"><%= heroicon 'user', class: 'w-5 h-5' %></span>
                <div>
                    <%= tag.h2 t('about.header.founder_name'), class: 'about-hero__founder-name' %>
                    <%= tag.p t('about.header.founder_title'), class: 'about-hero__founder-title' %>
                </div>
            </div>
        </div>
        <div class="about-hero__portrait">
            <%= image_tag 'about/owner-Aleksandr.webp', alt: "#{t('about.header.founder_name')} — #{t('about.header.founder_title')}" %>
            <span class="about-hero__portrait-caption"><%= t('about.header.founder_title') %></span>
        </div>
    </div>
</section>