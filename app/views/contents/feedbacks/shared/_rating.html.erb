<section class="feedback-score" aria-label="<%= t('feedback.total_rating') %>">
    <span class="feedback-score__icon"><%= heroicon 'star', variant: 'solid', class: 'w-6 h-6' %></span>
    <div class="feedback-score__value">
        <%= number_with_precision(@total_rating, precision: 1) %>
    </div>
    <div class="feedback-score__details">
        <span class="feedback-score__label"><%= t('feedback.total_rating') %></span>
        <% if Feedback.count.positive? %>
            <div class="feedback-score__stars" aria-hidden="true">
                <% 1.upto(5) do |i| %>
                    <%= heroicon 'star', variant: 'solid', class: "w-4 h-4 #{review_star_color(@total_rating, i)}" %>
                <% end %>
            </div>
            <span class="feedback-score__count"><%= t('review.total_ratings_count', count: Feedback.count) %></span>
        <% else %>
            <span class="feedback-score__count"><%= t('review.no_feedback') %></span>
        <% end %>
    </div>
</section>
