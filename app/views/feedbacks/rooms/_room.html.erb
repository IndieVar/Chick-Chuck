<%= turbo_stream_from [current_user, room]%>

<% participants = room.users.to_a %>
<% recipient = participants.find { |user| user.id != current_user.id } %>
<% messages = room.messages.to_a %>
<% last_message = messages.max_by(&:created_at) %>
<% unread_count = messages.count { |message| message.user_id != current_user.id && !message.readed? } %>

<%= turbo_frame_tag room do %>
    <% if current_user.class.name != Company.name || messages.any? %>
        <%= link_to room_path(title: room.title), class: "chat-room" do %>
            <!-- Recipient avatar -->
            <%= image_tag recipient.avatar_thumb, class: "chat-room__avatar", alt: "" %>
            <!-- Recipient username and last message -->
            <div class="chat-room__body">
                <%= tag.div recipient.user_name, class: "chat-room__name" %>
                <%= render 'feedbacks/rooms/last_message', room: room, last_message: %>
            </div>
            <!-- Unread messages count and time -->
            <div class="chat-room__meta">
                <%= render 'feedbacks/rooms/unread_messages', room: room, count: unread_count, last_message: %>
            </div>
        <% end %>
    <% end %>
<% end if participants.size > 1 %>
