<section class="home-newsletter" id="newsletter">
    <div class="home-newsletter__copy">
        <%= tag.h2 t('home_page.redesign.newsletter_title'), class: 'home-newsletter__title' %>
        <%= tag.p t('home_page.redesign.newsletter_description'), class: 'home-newsletter__description' %>
    </div>
    <div class="home-newsletter__form">
        <%= render 'users/mailers/form'%>
        <small><%= t('home_page.redesign.newsletter_note') %></small>
    </div>
</section>

