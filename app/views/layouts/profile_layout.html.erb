<!DOCTYPE html>
<html class="h-full bg-gray-50" <%= html_language_attributes %>>
  <head>
    <!-- Meta -->
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title><%= full_title(yield(:page_title)) %></title>
    <%= render 'shared/meta/favicon'%>
    <%= render 'shared/meta/head_assets' %>
    <!-- Trix -->
    <%= javascript_import_module_tag "trix" %>
    <%= javascript_import_module_tag "@rails/actiontext" %>
    <!-- Current user -->
    <%= render 'shared/meta/current_user_meta'%>
  </head>

  <body class="flex min-h-screen w-full flex-col justify-between">
      <% if user_signed_in? %>
        <%= turbo_stream_from "broadcast_to_user_#{current_user.id}" %>
      <% end %>
      <!-- Header -->
      <%= yield :navbar%>
      <!-- Main -->
      <% chat_room = [controller_name, action_name].eql?(['rooms', 'show']) %>
      <main class="cabinet <%= 'cabinet--chat' if chat_room %>" id="top">
          <!-- Profile sidebar menu -->
          <%= tag.aside (render 'shared/navigations/user_profile_sidebar'), class: "cabinet__sidebar" if user_signed_in? %>
          <div class="cabinet__main">
              <!-- Page Navigation -->
              <%= render 'shared/navigations/profile_navigation' unless chat_room %>
              <!-- Flash messages -->
              <%= tag.div (render 'shared/flash_messages'), class: 'fixed right-3 sm:right-6 sm:top-20 z-30 sm:max-w-sm', id: "flash_messages" %>
              <section class="cabinet__card">
                  <%= tag.h1 yield(:main_title), class: "cabinet__title" if yield(:main_title).present? %>
                  <!-- Content -->
                  <%= yield %>
              </section>
          </div>
      </main>
      <!-- Footer -->
      <%= yield :footer unless [controller_name, action_name].eql?(['rooms', 'show'])%>
  </body>
</html>
