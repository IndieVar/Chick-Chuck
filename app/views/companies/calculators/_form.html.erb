<!-- Calculator form -->
<%= form_with model: model, url: companies_calculator_path, class: 'pcalc-card' do |f|%>
    <!-- Errors -->
    <%= render 'shared/error_messages', resource: model%>
    <!-- Title -->
    <%= tag.h2 t('calculator.options'), class: "pcalc-card__title" %>
    <div class="pcalc-fields">
        <% [[:distance, t('calculator.km_span')],
            [:floor_down, t('calculator.floor_span')],
            [:floor_down_elevator, t('calculator.floor_span')],
            [:floor_up, t('calculator.floor_span')],
            [:floor_up_elevator, t('calculator.floor_span')]].each do |field, unit| %>
            <div class="pcalc-field">
                <%= f.label field, class: "pcalc-field__label" %>
                <div class="pcalc-field__control">
                    <%= f.number_field field, class: "pcalc-input", required: true %>
                    <span class="pcalc-unit" <%= 'id=distance_flash_message' if field == :distance %>><%= unit %></span>
                    <%= image_tag(asset_path('icons/icons8-done-40.png'), class: 'pcalc-done', alt: '') if model&.public_send(field).present? %>
                </div>
            </div>
        <% end %>
    </div>
    <!-- Button save -->
    <div class="pcalc-card__actions">
        <%= f.submit t('global.save_btn'), class: 'pcalc-save' %>
    </div>
<% end %>
