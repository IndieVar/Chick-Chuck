<%= provide :navbar do %>
    <header class="bg-white bg-opacity-90 fixed top-0 z-50 w-full">
        <div class="relative" data-controller="dropdown">
          <div class="w-full mx-auto px-4 sm:px-6">
            <div class="relative flex min-w-0 items-center gap-2 border-b-2 border-gray-100 py-4 sm:gap-4">
              <!-- Logotype -->
              <div class="flex min-w-0 flex-1 justify-start">
                  <%= link_to root_path, class: 'flex items-center', data: {turbo_frame: '_top'} do %>
                      <!-- Chick-Chuck logotype mobile -->
                      <%= image_tag('logo/chick-chuck-mobile-logo.webp', 
                        class: "sm:hidden h-10 w-10 object-cover object-center", alt: 'chick-chuck-logotype') %>
                      <!-- Chick-Chuck logotype -->
                      <%= image_tag('logo/chick-chuck-logo.webp', 
                        class: "hidden sm:block h-10 w-56 object-cover", alt: 'chick-chuck-logotype')%>
                  <% end %>
              </div>
              <!-- Mobile menu button -->
              <div class="absolute left-1/2 flex -translate-x-1/2 justify-center xl:hidden">
                <button 
                    data-action="dropdown#toggle click@window->dropdown#hide" 
                    type="button" 
                    class="inline-flex h-11 w-11 items-center justify-center rounded-xl bg-gray-100/90 text-gray-700 border border-gray-300 shadow-sm hover:bg-gray-200 focus:outline-none focus:ring-2 focus:ring-indigo-500"
                    aria-label="<%= t('global.open_menu') %>"
                    aria-controls="mobile-menu-button"
                    aria-expanded="false"
                >
                    <%= heroicon 'bars-3', class: 'h-7 w-7'%>
                </button>
              </div>
              <!-- Navigations -->
              <nav class="hidden shrink-0 space-x-4 lg:space-x-6 rtl:space-x-reverse lg:flex">
                  <%= render 'shared/navigations/content_links_list', 
                      link_class: "text-base font-medium hover:text-gray-900",
                      current_page: current_page %>
              </nav>
              <!-- User menu -->
              <div class="flex w-auto flex-none items-center justify-end gap-2 sm:flex-1 sm:gap-4 lg:gap-5 space-x-2 rtl:space-x-reverse">
                  <!-- Locales -->
                  <%= render 'shared/locales'%>
                  <!-- Menu -->
                  <%= render 'shared/navigations/user_menu'%>
              </div>
            </div>
          </div>
          <!-- Mobile menu -->
          <div class="xl:hidden">
            <%= render 'shared/navigations/mobile_menu', current_page: current_page %>
          </div>
        </div>
    </header>
<% end %>