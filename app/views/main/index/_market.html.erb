<section class="home-section home-market">
    <div class="home-section__heading">
        <div>
            <%= tag.h2 t('home_page.redesign.market_title'), class: 'home-section__title' %>
            <%= tag.p t('home_page.redesign.market_description'), class: 'home-section__description' %>
        </div>
        <%= link_to products_path, class: 'home-text-link', data: { turbo_frame: '_top' } do %>
            <%= t('global.view_all') %>
            <%= heroicon I18n.locale == :he ? 'arrow-small-left' : 'arrow-small-right', class: 'w-5 h-5' %>
        <% end %>
    </div>

    <%= turbo_frame_tag 'products', class: 'home-market-grid' do %>
        <% if @products.present? %>
            <%= render partial: 'contents/products/product', collection: @products %>
        <% else %>
            <%= tag.div (render 'contents/shared/unavailable', model: t('product.products')), class: 'col-span-full' %>
        <% end %>
    <% end %>
</section>